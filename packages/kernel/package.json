{
  "name": "@factotum/kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The daemon: config, state roots, bind, origin policy, module registry, HTTP.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude=\"**/dist/**\" --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-lines=80 --test-coverage-branches=80 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@factotum/core": "workspace:*",
    "web-push": "3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4"
  }
}
