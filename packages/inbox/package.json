{
  "name": "@factotum/inbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The mail digest: reads IMAP read-only, classifies with claude, keeps the result. Knows nothing about HTTP.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude=\"**/dist/**\" --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"src/test-*.ts\" --test-coverage-exclude=\"test/**\" --test-coverage-lines=80 --test-coverage-branches=80 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@factotum/core": "workspace:*",
    "@factotum/sessions": "workspace:*",
    "imapflow": "2.2.5",
    "zod": "^4.1.12"
  }
}
